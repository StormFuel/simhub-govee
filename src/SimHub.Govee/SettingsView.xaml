<UserControl x:Class="SimHub.Govee.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SimHub.Govee">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22" MaxWidth="1050" HorizontalAlignment="Left">
      <TextBlock Text="Govee Controller Plugin for SimHub" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Hybrid control for compatible Govee room lights, with reusable presets, game profiles, and SimHub actions." Margin="0,5,0,18" TextWrapping="Wrap"/>
      <GroupBox Header="1. Govee Developer API" Padding="12" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Paste your own Developer API key. It is encrypted for your Windows account and is never shown again." TextWrapping="Wrap"/>
        <DockPanel Margin="0,8,0,0"><PasswordBox x:Name="ApiKeyBox" MinWidth="360" Margin="0,0,8,0"/><Button Content="Save key" Click="SaveKey_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="Remove key" Click="RemoveKey_Click" Padding="14,5"/></DockPanel><TextBlock x:Name="KeyStatusText" Margin="0,7,0,0"/>
      </StackPanel></GroupBox>
      <GroupBox Header="2. Devices" Padding="12" Margin="0,0,0,12"><StackPanel>
        <DockPanel Margin="0,0,0,8"><Button Content="Refresh from Govee" Click="Refresh_Click" Padding="14,5" Margin="0,0,8,0"/><CheckBox x:Name="HideLogicalCheck" Content="Hide DreamView logical devices" VerticalAlignment="Center" Checked="SettingChanged" Unchecked="SettingChanged"/></DockPanel>
        <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="160" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Selected}" Width="45"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Model" Binding="{Binding Sku}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Optional reserved IP for local control" Binding="{Binding IpAddress}" Width="220"/><DataGridComboBoxColumn Header="Transport" SelectedItemBinding="{Binding Transport}" ItemsSource="{x:Static local:SettingsView.TransportModes}" Width="120"/></DataGrid.Columns></DataGrid>
        <Border Background="#203A72" Padding="10" Margin="0,8,0,0" CornerRadius="3"><TextBlock Foreground="White" Text="The IP address is optional for Cloud mode. For Hybrid/local control, reserve it in DHCP, enable LAN Control in Govee Home, and enter it here. Across VLANs, permit outbound UDP 4003." TextWrapping="Wrap"/></Border>
        <WrapPanel Margin="0,10,0,0"><Button Content="Save all settings" Click="Save_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="Test ON + verify" Click="TestOn_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="Test OFF + verify" Click="TestOff_Click" Padding="14,5" Margin="0,0,8,0"/><Button Content="Device compatibility test / report…" Click="CompatibilityReport_Click" Padding="14,5"/></WrapPanel>
      </StackPanel></GroupBox>
      <GroupBox Header="3. Light presets" Padding="12" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Presets use a dedicated Simple/Advanced editor. Double-click a row or use Edit. 'Custom' means the effective result is not one uniform value." TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DataGrid x:Name="PresetsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="140" MouseDoubleClick="PresetDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Color" Binding="{Binding ColorSummary}" Width="90"/><DataGridTextColumn Header="Brightness" Binding="{Binding BrightnessSummary}" Width="90"/><DataGridTextColumn Header="Mode" Binding="{Binding AppearanceSummary}" Width="90"/><DataGridCheckBoxColumn Header="Turn on" Binding="{Binding TurnOn}" Width="70"/><DataGridTextColumn Header="Targets" Binding="{Binding TargetSummary}" Width="140"/></DataGrid.Columns></DataGrid>
        <WrapPanel Margin="0,8,0,0"><Button Content="Add…" Click="AddPreset_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Edit…" Click="EditPreset_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Delete…" Click="DeletePreset_Click" Padding="12,5"/></WrapPanel>
        <CheckBox x:Name="ShowLivePreviewWarningCheck" Content="Show the safety warning before live segmented preview" Margin="0,9,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
      </StackPanel></GroupBox>
      <GroupBox Header="4. Game profiles" Padding="12" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="The Default Game Profile applies when no enabled custom profile matches. All profiles use the same dialog-based workflow." TextWrapping="Wrap"/>
        <Border BorderBrush="#667080" BorderThickness="1" Padding="10" Margin="0,8,0,10"><DockPanel><Button Content="Edit default…" Click="EditDefaultProfile_Click" DockPanel.Dock="Right" Padding="12,5"/><TextBlock x:Name="DefaultProfileSummaryText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="130" MouseDoubleClick="ProfileDoubleClick"><DataGrid.Columns><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="65"/><DataGridTextColumn Header="Game" Binding="{Binding GameCode}" Width="2*"/><DataGridTextColumn Header="Behavior" Binding="{Binding Behavior}" Width="120"/><DataGridTextColumn Header="Preset" Binding="{Binding PresetName}" Width="*"/><DataGridTextColumn Header="Targets" Binding="{Binding TargetSummary}" Width="140"/></DataGrid.Columns></DataGrid>
        <WrapPanel Margin="0,8,0,0"><Button Content="Add…" Click="AddProfile_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Edit…" Click="EditProfile_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Delete…" Click="DeleteProfile_Click" Padding="12,5"/></WrapPanel>
        <Expander Header="How Restore Previous works" Margin="0,10,0,0"><TextBlock Margin="8" TextWrapping="Wrap" Text="Hybrid/Cloud devices restore known power, brightness, and RGB. Local-only and segmented restoration use the plugin's last commanded state when available. External scenes and modes cannot be reconstructed exactly."/></Expander>
      </StackPanel></GroupBox>
      <GroupBox Header="5. SimHub actions" Padding="12" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Double-click any action to configure it. Built-in power/toggle actions allow target selection while keeping their identity and behavior locked. Managed color actions open their owning preset; custom action keys remain immutable." TextWrapping="Wrap"/>
        <CheckBox x:Name="RefreshStateBeforeActionCheck" Content="Refresh power state from Govee Cloud before every SimHub action" Margin="0,10,0,8" Checked="SettingChanged" Unchecked="SettingChanged"/>
        <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="140" MouseDoubleClick="ActionDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Registered action (immutable)" Binding="{Binding RegisteredName}" Width="2*"/><DataGridTextColumn Header="Label" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Preset" Binding="{Binding PresetName}" Width="*"/><DataGridTextColumn Header="Targets" Binding="{Binding TargetSummary}" Width="140"/></DataGrid.Columns></DataGrid>
        <WrapPanel Margin="0,8,0,0"><Button Content="Add…" Click="AddAction_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Edit…" Click="EditAction_Click" Padding="12,5" Margin="0,0,8,0"/><Button Content="Delete…" Click="DeleteAction_Click" Padding="12,5"/></WrapPanel>
      </StackPanel></GroupBox>
      <GroupBox Header="6. SimHub lifecycle" Padding="12" Margin="0,0,0,12"><StackPanel>
        <WrapPanel><TextBlock Text="At SimHub start:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StartupPolicyBox" Width="170" SelectionChanged="SettingChanged"/><CheckBox x:Name="StartupOnCheck" Content="Configured state is ON" Margin="16,2,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/></WrapPanel>
        <WrapPanel Margin="0,10,0,0"><TextBlock Text="Startup color profile:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StartupPresetBox" Width="240" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SettingChanged"/></WrapPanel><TextBlock Text="Configured State applies the chosen preset. No preset uses the ON/OFF checkbox. Leave Unchanged sends neither." FontSize="11" Opacity="0.78" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,10,0,0"><TextBlock Text="At clean exit:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ExitPolicyBox" Width="170" SelectionChanged="SettingChanged"/><CheckBox x:Name="ExitOnCheck" Content="Configured state is ON" Margin="16,2,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/></WrapPanel><CheckBox x:Name="FallbackCheck" Content="Automatically fall back to cloud control" Margin="0,10,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
      </StackPanel></GroupBox>
      <GroupBox Header="7. Status and recovery" Padding="12"><StackPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap"/><Separator Margin="0,12,0,10"/><TextBlock Text="Reset returns this module to first-run defaults and removes its encrypted API key, devices, presets, profiles, action configuration, lifecycle choices, and preferences. It does not command the lights. Restart SimHub afterward." TextWrapping="Wrap"/><Button Content="Reset all plugin settings…" Click="ResetAllSettings_Click" Background="#B43A3A" Foreground="White" Padding="14,6" Margin="0,9,0,0" HorizontalAlignment="Left"/></StackPanel></GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
