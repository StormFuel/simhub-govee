<Window x:Class="SimHub.Govee.GameProfileEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game profile" Width="560" SizeToContent="Height" MaxHeight="720" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock x:Name="HeadingText" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="A profile applies as soon as SimHub detects the game process. The Default Game Profile is used when no enabled custom profile matches." TextWrapping="Wrap" Margin="0,5,0,12"/>
    <CheckBox x:Name="EnabledCheck" Content="Profile enabled" Margin="0,0,0,10"/>
    <TextBlock Text="Registered SimHub game" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,4,0,10"><ComboBox x:Name="GameBox" Width="330" DisplayMemberPath="DisplayName" SelectedValuePath="Code" IsTextSearchEnabled="True" Margin="0,0,8,0"/><Button x:Name="DetectedButton" Content="Use detected game" Click="UseDetected_Click" Padding="11,4"/></WrapPanel>
    <TextBlock Text="Behavior" FontWeight="SemiBold"/><ComboBox x:Name="BehaviorBox" Width="180" HorizontalAlignment="Left" Margin="0,4,0,10" SelectionChanged="BehaviorChanged"/>
    <TextBlock Text="Preset" FontWeight="SemiBold"/><ComboBox x:Name="PresetBox" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" SelectionChanged="PresetChanged"/>
    <TextBlock Text="Target lights" FontWeight="SemiBold"/>
    <RadioButton x:Name="AllTargetsRadio" Content="All lights selected in Devices" GroupName="ProfileTargets" Checked="TargetModeChanged" Margin="0,5,0,3"/>
    <RadioButton x:Name="SpecificTargetsRadio" Content="Only these lights:" GroupName="ProfileTargets" Checked="TargetModeChanged"/>
    <StackPanel x:Name="TargetsPanel" Margin="20,5,0,0"/>
    <TextBlock x:Name="ErrorText" Foreground="#D05040" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <WrapPanel Margin="0,14,0,0"><Button Content="Save" Click="Save_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0"/><Button Content="Cancel" IsCancel="True" Padding="14,6"/></WrapPanel>
  </StackPanel></ScrollViewer>
</Window>
