<Window x:Class="SimHub.Govee.ActionEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SimHub action" Width="540" SizeToContent="Height" MaxHeight="700" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock x:Name="HeadingText" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="IntroText" Text="The registered action key is permanent after creation so existing Controls and Events or Dash Studio bindings remain valid." TextWrapping="Wrap" Margin="0,5,0,12"/>
    <TextBlock Text="Immutable action key" FontWeight="SemiBold"/><TextBox x:Name="KeyBox" Margin="0,4,0,10"/>
    <TextBlock Text="Display label" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,4,0,10"/>
    <TextBlock Text="Action type" FontWeight="SemiBold"/><ComboBox x:Name="TypeBox" Width="200" HorizontalAlignment="Left" Margin="0,4,0,10" SelectionChanged="TypeChanged"/>
    <TextBlock Text="Color preset" FontWeight="SemiBold"/><ComboBox x:Name="PresetBox" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10"/>
    <TextBlock Text="Target lights" FontWeight="SemiBold"/>
    <RadioButton x:Name="AllTargetsRadio" Content="All lights selected in Devices" GroupName="ActionTargets" Checked="TargetModeChanged" Margin="0,5,0,3"/>
    <RadioButton x:Name="SpecificTargetsRadio" Content="Only these lights:" GroupName="ActionTargets" Checked="TargetModeChanged"/>
    <StackPanel x:Name="TargetsPanel" Margin="20,5,0,0"/>
    <TextBlock x:Name="ErrorText" Foreground="#D05040" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <WrapPanel Margin="0,14,0,0"><Button Content="Save" Click="Save_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0"/><Button Content="Cancel" IsCancel="True" Padding="14,6"/></WrapPanel>
  </StackPanel></ScrollViewer>
</Window>
