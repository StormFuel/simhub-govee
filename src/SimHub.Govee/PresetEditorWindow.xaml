<Window x:Class="SimHub.Govee.PresetEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Light preset" Width="680" SizeToContent="Height" MaxHeight="780" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">
      <TextBlock x:Name="HeadingText" Text="Light preset" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Simple mode controls one color and brightness. Advanced mode adds device-specific segmented appearances without changing the preset's stable identity or SimHub action key." TextWrapping="Wrap" Margin="0,5,0,12"/>
      <TextBlock Text="Preset name" FontWeight="SemiBold"/>
      <TextBox x:Name="NameBox" Margin="0,4,0,12"/>
      <TabControl x:Name="ModeTabs">
        <TabItem Header="Simple">
          <StackPanel Margin="12">
            <TextBlock Text="Uniform fallback appearance" FontWeight="SemiBold"/>
            <TextBlock Text="This color and optional brightness apply to every target without a device-specific Advanced override." TextWrapping="Wrap" FontSize="11" Opacity="0.78" Margin="0,3,0,10"/>
            <TextBlock Text="Optional brightness (0–100)" FontWeight="SemiBold"/><TextBox x:Name="BrightnessBox" Width="80" HorizontalAlignment="Left" Margin="0,4,0,10"/>
            <TextBlock Text="Color" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,4,0,8">
              <TextBox x:Name="HexBox" Width="100" TextChanged="HexChanged" Margin="0,0,8,0" ToolTip="#RRGGBB"/>
              <Border x:Name="ColorPreview" Width="34" Height="24" BorderBrush="#667080" BorderThickness="1" Margin="0,0,8,0"/>
              <Button Content="Choose color…" Click="ChooseColor_Click" Padding="11,4"/>
            </WrapPanel>
            <WrapPanel x:Name="SwatchesPanel" Margin="0,0,0,10"/>
            <Border x:Name="AdvancedPreservedBanner" BorderBrush="#B58A20" BorderThickness="1" Padding="8" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock Text="This preset contains advanced appearances. Simple edits preserve them. Use Advanced → Convert to simple to remove them." TextWrapping="Wrap"/></Border>
          </StackPanel>
        </TabItem>
        <TabItem Header="Advanced">
          <StackPanel Margin="12">
            <TextBlock Text="The Simple color remains the fallback. Choose a verified target device to configure physical bars or individual segments with live preview." TextWrapping="Wrap"/>
            <TextBlock Text="Available verified devices (double-click to configure)" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <ListBox x:Name="AdvancedDeviceBox" MinHeight="70" MaxHeight="130" DisplayMemberPath="DisplayName" MouseDoubleClick="AvailableDeviceDoubleClick"/>
            <TextBlock Text="This list includes devices checked Use on the main screen that have a verified segment map. A new preset can be configured before you enter its name." TextWrapping="Wrap" FontSize="11" Opacity="0.78" Margin="0,4,0,0"/>
            <Button Content="Configure selected device…" Click="ConfigureSegments_Click" Padding="12,5" HorizontalAlignment="Left" Margin="0,8,0,10"/>
            <TextBlock Text="Configured overrides (double-click to reopen)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="OverridesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120" MouseDoubleClick="OverrideDoubleClick">
              <DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*"/><DataGridTextColumn Header="Appearance" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns>
            </DataGrid>
            <Button Content="Convert to simple preset…" Click="ConvertToSimple_Click" Padding="12,5" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </TabItem>
      </TabControl>
      <Border BorderBrush="#667080" BorderThickness="1" Padding="10" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Application behavior" FontWeight="SemiBold"/>
          <TextBlock Text="These settings apply in both Simple and Advanced appearance modes." TextWrapping="Wrap" FontSize="11" Opacity="0.78" Margin="0,3,0,8"/>
          <CheckBox x:Name="TurnOnCheck" Content="Turn the light on when this preset is applied" Margin="0,0,0,10"/>
          <TextBlock Text="Target lights" FontWeight="SemiBold"/>
          <RadioButton x:Name="AllTargetsRadio" Content="All lights selected in Devices" GroupName="PresetTargets" Checked="TargetModeChanged" Margin="0,5,0,3"/>
          <RadioButton x:Name="SpecificTargetsRadio" Content="Only these lights:" GroupName="PresetTargets" Checked="TargetModeChanged"/>
          <StackPanel x:Name="TargetsPanel" Margin="20,5,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="ErrorText" Foreground="#D05040" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <WrapPanel Margin="0,14,0,0">
        <Button Content="Save" Click="Save_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0"/>
        <Button Content="Cancel" IsCancel="True" Padding="14,6"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
